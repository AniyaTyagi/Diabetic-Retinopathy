APP_NAME=NetraX API
APP_ENV=development
SECRET_KEY=change-me-in-production-netrax-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local SQLite (default):
# DATABASE_URL=sqlite:///./netrax.db

# Neon Postgres — paste your connection string (keep sslmode=require):
# Example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./netrax.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
